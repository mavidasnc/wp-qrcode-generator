{
    "name": "mavida/wp-qrcode-generator",
    "description": "Gestione di codici QR con redirect o contenuti e statistiche di scansione.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [{ "name": "Mavida snc", "homepage": "https://www.mavida.com" }],
    "require": {
        "php": ">=8.2",
        "chillerlan/php-qrcode": "^6.0",
        "yahnis-elsts/plugin-update-checker": "^5.4"
    },
    "autoload": {
        "psr-4": { "Mavida\\QRCodeGenerator\\": "includes/" }
    },
    "config": { "optimize-autoloader": true, "platform": { "php": "8.2.0" } }
}
